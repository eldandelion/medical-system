# ==============================================================================
# Medical Screening System - Local Environment Configuration
# Copy this file to .env and fill in your private credentials.
# .env is ignored by Git and will NEVER be committed to GitHub.
# ==============================================================================

# Database Configuration (Defaults to MySQL in Docker on localhost:3307)
# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3307/medical_db?useSSL=false&allowPublicKeyRetrieval=true
# SPRING_DATASOURCE_USERNAME=root
# SPRING_DATASOURCE_PASSWORD=rootpassword

# QQ Mail SMTP Configuration for Verification Codes
# 1. Host & Port for QQ Mail (Port 465 SSL)
SPRING_MAIL_HOST=smtp.qq.com
SPRING_MAIL_PORT=465

# 2. Your QQ Email Address (e.g. 123456789@qq.com)
SPRING_MAIL_USERNAME=your_qq_number@qq.com

# 3. Your 16-letter QQ Mail Authorization Code (授权码)
# Generate via: mail.qq.com -> Settings -> Accounts -> POP3/IMAP/SMTP -> Generate Auth Code
SPRING_MAIL_PASSWORD=your_16_letter_authorization_code
